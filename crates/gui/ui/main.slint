    icon: @image-url("../../../assets/icon/server-on-256.png");
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1060px;
    min-height: 700px;
    background: @linear-gradient(165deg, #0C1219 0%, #0B0F14 60%, #090D12 100%);
    default-font-family: "Segoe UI";
    default-font-size: 12px;
    default-font-weight: 400;

    // ---------------------------------------------------------------------
    // Data models. Rust replaces these demo values with the daemon snapshot.
    // ---------------------------------------------------------------------
    in-out property <[ServiceItem]> services: [
        {
            id: "api-gateway",
            name: "api-gateway",
