// ServerOn — native Windows / WSL / Docker local service manager.
//
// This file is intentionally self-contained: all visual assets are drawn with
// Slint primitives or provided by the built-in Fluent widget set. The public
// properties below are populated by the Rust GUI host; see README.md for the
// mapping from the daemon snapshot to these models.
//
// Slint 1.x / fluent-dark.

import {
    Button,
    CheckBox,
    LineEdit,
    ScrollView,
    SpinBox,
    Switch,
    TextEdit,
} from "std-widgets.slint";

global Theme {
    out property <color> bg: #0B0F14;
    out property <color> bg-deep: #080B10;
    out property <color> surface: #0F151C;
    out property <color> panel: #121922;
    out property <color> panel-hover: #17212C;
    out property <color> panel-raised: #19232E;
    out property <color> sidebar: #0C1117;
    out property <color> border: #222D39;
    out property <color> border-soft: #19222C;
    out property <color> border-strong: #2C3A49;
    out property <color> text: #E9EFF7;
    out property <color> text-secondary: #9AA8B9;
    out property <color> text-muted: #657386;
    out property <color> accent: #4CB8FF;
    out property <color> accent-strong: #249BE7;
    out property <color> accent-soft: #112C3D;
    out property <color> success: #3DDC97;
    out property <color> warning: #F4B860;
    out property <color> danger: #FF7186;
    out property <color> info: #72B7FF;
    out property <color> violet: #B9A4FF;
    out property <color> teal: #45D4C4;
    out property <color> pink: #F58BB8;
    out property <string> mono-font: "Cascadia Mono";
}

global Ui {
    public pure function state-label(state: string) -> string {
        if state == "running" { return "运行中"; }
        if state == "starting" { return "启动中"; }
        if state == "stopping" { return "停止中"; }
        if state == "stopped" { return "已停止"; }
        if state == "failed" { return "失败"; }
        if state == "degraded" { return "降级"; }
        if state == "unknown" { return "未知"; }
        if state == "missing" { return "已丢失"; }
        return "未知";
    }

    public pure function state-tone(state: string) -> color {
        if state == "running" { return Theme.success; }
        if state == "starting" { return Theme.info; }
        if state == "stopping" { return Theme.warning; }
        if state == "failed" { return Theme.danger; }
        if state == "degraded" { return Theme.warning; }
        if state == "unknown" { return Theme.violet; }
        if state == "missing" { return Theme.pink; }
        return Theme.text-muted;
    }

    public pure function health-label(health: string) -> string {
        if health == "healthy" { return "健康"; }
        if health == "unhealthy" { return "异常"; }
        if health == "checking" { return "检查中"; }
        if health == "not-configured" { return "未配置"; }
        if health == "unknown" { return "未知"; }
        return health == "" ? "未配置" : health;
    }

    public pure function health-tone(health: string) -> color {
        if health == "healthy" { return Theme.success; }
        if health == "unhealthy" { return Theme.danger; }
        if health == "checking" { return Theme.info; }
        if health == "unknown" { return Theme.warning; }
        return Theme.text-muted;
    }

    public pure function kind-label(kind: string) -> string {
        if kind == "windows" { return "Windows"; }
        if kind == "wsl" { return "WSL"; }
        if kind == "container" { return "容器"; }
        return kind;
    }

    public pure function kind-glyph(kind: string) -> string {
        if kind == "windows" { return "W"; }
        if kind == "wsl" { return ">_"; }
        if kind == "container" { return "▣"; }
        return "·";
    }

    public pure function kind-tone(kind: string) -> color {
        if kind == "windows" { return Theme.info; }
        if kind == "wsl" { return Theme.violet; }
        if kind == "container" { return Theme.teal; }
        return Theme.text-muted;
    }

    public pure function engine-tone(engine: string) -> color {
        if engine == "available" { return Theme.success; }
        if engine == "unavailable" { return Theme.danger; }
        if engine == "unknown" { return Theme.warning; }
        return Theme.text-muted;
    }

    public pure function log-label(level: string) -> string {
        if level == "error" || level == "stderr" { return "错误"; }
        if level == "warn" { return "警告"; }
        if level == "info" { return "信息"; }
        if level == "stdout" { return "输出"; }
        if level == "system" { return "系统"; }
        if level == "debug" { return "调试"; }
        return level;
    }

    public pure function log-tone(level: string) -> color {
        if level == "error" || level == "stderr" { return Theme.danger; }
        if level == "warn" { return Theme.warning; }
        if level == "info" { return Theme.info; }
        if level == "system" { return Theme.violet; }
        if level == "debug" { return Theme.text-muted; }
        return Theme.text-secondary;
    }

    public pure function log-message-tone(level: string) -> color {
        if level == "error" || level == "stderr" { return #FFC2CB; }
        if level == "warn" { return #F9DAA8; }
        return Theme.text-secondary;
    }

    public pure function filter-title(filter: string) -> string {
        if filter == "running" { return "运行中的服务"; }
        if filter == "issues" { return "需要关注"; }
        if filter == "stopped" { return "已停止的服务"; }
        return "全部服务";
    }
}

export struct ServiceItem {
    id: string,
    name: string,
    kind: string,
    distribution: string,
    subtitle: string,
    state: string,
    health: string,
    matches-search: bool,
}

export struct DistributionItem {
    name: string,
    version: string,
    state: string,
    engine-state: string,
    engine-label: string,
    container-count: int,
}

export struct LogLine {
    time: string,
    level: string,
    message: string,
}

export struct ServiceConfig {
    id: string,
    name: string,
    runtime-kind: string,
    type-label: string,
    origin-label: string,
    state: string,
    health: string,
    detail: string,
    status-message: string,
    distribution: string,
    working-directory: string,
    shell: string,
    script: string,
    environment: string,
    health-check-kind: string,
    health-target: string,
    stop-timeout: int,
    auto-start: bool,
    restart-policy: string,
    ports: string,
    pid: string,
    uptime: string,
    cpu: string,
    memory: string,
}

component StatusDot inherits Rectangle {
    in property <color> tone: Theme.success;
    in property <bool> halo: false;

    width: 8px;
    height: 8px;
    background: transparent;

    if root.halo : Rectangle {
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 7px;
        background: root.tone.with-alpha(0.13);
    }

    Rectangle {
        width: 6px;
        height: 6px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 3px;
        background: root.tone;
    }
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.text-secondary;
    in property <bool> dot: true;

    height: 22px;
    horizontal-stretch: 0;
    border-radius: 11px;
    background: root.tone.with-alpha(0.10);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.22);
    vertical-stretch: 0;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 9px;
        spacing: 5px;
        alignment: center;

        if root.dot : Rectangle {
            width: 5px;
            height: 5px;
            border-radius: 2.5px;
            background: root.tone;
        }

        Text {
            text: root.text;
            color: root.tone;
            font-size: 11px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component HealthLabel inherits HorizontalLayout {
    in property <string> health: "not-configured";

    spacing: 5px;
    alignment: center;

    Rectangle {
        width: 5px;
        height: 5px;
        border-radius: 2.5px;
        background: Ui.health-tone(root.health);
    }

    Text {
        text: Ui.health-label(root.health);
        color: Ui.health-tone(root.health);
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }
}

component IconAction inherits Rectangle {
    in property <string> glyph;
    in property <string> tooltip;
    in property <color> tone: Theme.text-secondary;
    in property <bool> available: true;
    callback clicked;

    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: transparent;
    opacity: root.available ? 1 : 0.32;
    animate background { duration: 100ms; }

    Text {
        text: root.glyph;
        color: root.tone;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    ta := TouchArea {
        enabled: root.available;
        clicked => { root.clicked(); }
    }

    states [
        hover when ta.has-hover && root.available : {
            background: root.tone.with-alpha(0.10);
        }
        pressed when ta.pressed && root.available : {
            background: root.tone.with-alpha(0.16);
        }
    ]

    Tooltip {
        text: @markdown("\{root.tooltip}");
    }
}

component QuickAction inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <color> tone: Theme.text-secondary;
    in property <bool> available: true;
    callback clicked;

    height: 28px;
    horizontal-stretch: 1;
    border-radius: 6px;
    background: root.tone.with-alpha(root.available ? 0.08 : 0.03);
    border-width: 1px;
    border-color: root.tone.with-alpha(root.available ? 0.18 : 0.08);
    opacity: root.available ? 1 : 0.34;

    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        padding-left: 4px;
        padding-right: 4px;

        Text {
            text: root.glyph;
            color: root.tone;
            font-size: 10px;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: root.tone;
            font-size: 11px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        enabled: root.available;
        clicked => { root.clicked(); }
    }

    states [
        hover when ta.has-hover && root.available : {
            background: root.tone.with-alpha(0.14);
        }
        pressed when ta.pressed && root.available : {
            background: root.tone.with-alpha(0.20);
        }
    ]

    Tooltip {
        text: @markdown("\{root.label}服务");
    }
}

component FilterChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    height: 30px;
    horizontal-stretch: 0;
    border-radius: 7px;
    background: root.active ? Theme.accent-soft : transparent;
    border-width: 1px;
    border-color: root.active ? #2B5A76 : transparent;
    animate background, border-color { duration: 120ms; }

    Text {
        text: root.label;
        color: root.active ? Theme.accent : Theme.text-secondary;
        font-size: 11.5px;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    states [
        hover when ta.has-hover && !root.active : {
            background: Theme.panel-hover;
        }
    ]

    accessible-role: button;
    accessible-label: root.label;
}

component NavRow inherits Rectangle {
    in property <string> label;
    in property <int> count: 0;
    in property <string> glyph;
    in property <color> tone: Theme.text-muted;
    in property <bool> selected: false;
    callback clicked;

    height: 32px;
    border-radius: 7px;
    background: root.selected ? Theme.accent-soft : transparent;
    animate background { duration: 120ms; }

    Rectangle {
        visible: root.selected;
        x: 0;
        y: 8px;
        width: 2px;
        height: 16px;
        border-radius: 1px;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 9px;
        spacing: 9px;

        Text {
            text: root.glyph;
            color: root.selected ? Theme.accent : root.tone;
            font-size: 11px;
            width: 16px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: root.selected ? Theme.text : Theme.text-secondary;
            font-size: 12px;
            font-weight: root.selected ? 500 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Text {
            text: "" + root.count;
            color: root.selected ? Theme.accent : Theme.text-muted;
            font-size: 10.5px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    states [
        hover when ta.has-hover && !root.selected : {
            background: #FFFFFF06;
        }
    ]

    accessible-role: button;
    accessible-label: root.label;
}

component SidebarHeading inherits Rectangle {
    in property <string> title;
    in property <string> count-text;

    height: 28px;

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 6px;
        alignment: center;

        Text {
            text: root.title;
            color: Theme.text-muted;
            font-size: 9.5px;
            font-weight: 600;
            letter-spacing: 0.7px;
            vertical-alignment: center;
        }

        Text {
            text: root.count-text;
            color: Theme.text-muted;
            font-size: 9.5px;
            vertical-alignment: center;
        }
    }
}

component SidebarService inherits Rectangle {
    in property <ServiceItem> item;
    in property <bool> selected: false;
    in property <length> indent: 0px;
    callback select;

    height: 30px;
    border-radius: 6px;
    background: root.selected ? Theme.accent-soft : transparent;
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 10px + root.indent;
        padding-right: 8px;
        spacing: 7px;
        alignment: center;

        StatusDot {
            tone: Ui.state-tone(root.item.state);
        }

        Text {
            text: root.item.name;
            color: root.selected ? Theme.text : Theme.text-secondary;
            font-size: 11.5px;
            font-weight: root.selected ? 500 : 400;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.item.kind == "container" ? "容器" : "";
            color: Theme.text-muted;
            font-size: 9px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => { root.select(); }
    }

    states [
        hover when ta.has-hover && !root.selected : {
            background: #FFFFFF06;
        }
    ]

    Tooltip {
        text: @markdown("\{root.item.name} · \{Ui.state-label(root.item.state)}");
    }

    accessible-role: button;
    accessible-label: root.item.name;
}

component ServiceRow inherits Rectangle {
    in property <ServiceItem> item;
    in property <bool> selected: false;
    callback select;
    callback start;
    callback stop;
    callback restart;

    height: 64px;
    border-radius: 8px;
    background: root.selected ? #112230 : transparent;
    border-width: 1px;
    border-color: root.selected ? #284B61 : transparent;
    animate background, border-color { duration: 120ms; }

    Rectangle {
        visible: root.selected;
        x: 0;
        y: 16px;
        width: 2px;
        height: 32px;
        border-radius: 1px;
        background: Theme.accent;
    }

    ta := TouchArea {
        clicked => { root.select(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;
        alignment: center;

        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: Ui.kind-tone(root.item.kind).with-alpha(0.11);
            border-width: 1px;
            border-color: Ui.kind-tone(root.item.kind).with-alpha(0.20);
            vertical-stretch: 0;

            Text {
                text: Ui.kind-glyph(root.item.kind);
                color: Ui.kind-tone(root.item.kind);
                font-size: root.item.kind == "container" ? 15px : 11px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.item.name;
                color: Theme.text;
                font-size: 12.5px;
                font-weight: 500;
                overflow: elide;
            }

            Text {
                text: root.item.subtitle;
                color: Theme.text-muted;
                font-size: 10.5px;
                overflow: elide;
            }
        }

        Pill {
            text: Ui.state-label(root.item.state);
            tone: Ui.state-tone(root.item.state);
        }

        HealthLabel {
            health: root.item.health;
            width: 56px;
        }

        HorizontalLayout {
            spacing: 2px;
            horizontal-stretch: 0;

            IconAction {
                glyph: "▶";
                tooltip: "启动服务";
                tone: Theme.success;
                available: root.item.state == "stopped" || root.item.state == "failed";
                clicked => { root.start(); }
            }

            IconAction {
                glyph: "■";
                tooltip: "停止服务";
                tone: Theme.text-secondary;
                available: root.item.state == "running" || root.item.state == "degraded";
                clicked => { root.stop(); }
            }

            IconAction {
                glyph: "↻";
                tooltip: "重启服务";
                tone: Theme.accent;
                available: root.item.state == "running" || root.item.state == "degraded"
                    || root.item.state == "failed";
                clicked => { root.restart(); }
            }
        }
    }

    states [
        hover when ta.has-hover && !root.selected : {
            background: Theme.panel-hover;
        }
    ]

    accessible-role: list-item;
    accessible-label: root.item.name + "，" + Ui.state-label(root.item.state);
}

component SummaryStat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;

    spacing: 1px;

    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: 9.5px;
        font-weight: 500;
        letter-spacing: 0.4px;
    }

    Text {
        text: root.value;
        color: Theme.text;
        font-size: 12px;
        font-weight: 500;
        overflow: elide;
    }
}

component SegmentButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    height: 26px;
    horizontal-stretch: 1;
    border-radius: 5px;
    background: root.active ? Theme.panel-raised : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: Theme.border-strong;
    animate background { duration: 100ms; }

    Text {
        text: root.label;
        color: root.active ? Theme.text : Theme.text-muted;
        font-size: 10.5px;
        font-weight: root.active ? 500 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    states [
        hover when ta.has-hover && !root.active : {
            background: #FFFFFF06;
        }
    ]

    accessible-role: button;
    accessible-label: root.label;
}

component ReadOnlyField inherits VerticalLayout {
    in property <string> label;
    in property <string> value;

    spacing: 2px;

    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: 9.5px;
        font-weight: 500;
        letter-spacing: 0.3px;
    }

    Text {
        text: root.value;
        color: Theme.text;
        font-size: 11.5px;
        overflow: elide;
    }
}

export component AppWindow inherits Window {
