import { ServiceItem, LogLine, MetricPoint } from "models.slint";
import { Theme, Ui } from "theme.slint";

component StatusDot inherits Rectangle {
    in property <color> tone: Theme.success;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.tone;
}

component AppIcon inherits Rectangle {
    in property <string> name: "grid";
    in property <color> tone: Theme.text-secondary;
    in property <length> icon-size: 16px;
    private property <bool> filled: root.name == "play" || root.name == "stop" || root.name == "moon" || root.name == "windows";
    width: root.icon-size;
    height: root.icon-size;
    accessible-role: none;

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.name == "play" ? "M 5 3 L 13 8 L 5 13 Z" :
            root.name == "stop" ? "M 4 4 L 12 4 L 12 12 L 4 12 Z" :
            root.name == "windows" ? "M 2 3 L 7.3 3 L 7.3 7.3 L 2 7.3 Z M 8.7 3 L 14 3 L 14 7.3 L 8.7 7.3 Z M 2 8.7 L 7.3 8.7 L 7.3 14 L 2 14 Z M 8.7 8.7 L 14 8.7 L 14 14 L 8.7 14 Z" :
            root.name == "container" ? "M 8 1.8 L 13.5 5 L 13.5 11 L 8 14.2 L 2.5 11 L 2.5 5 Z M 2.5 5 L 8 8.2 L 13.5 5 M 8 8.2 L 8 14.2 M 5.3 3.4 L 10.8 6.6" :
            root.name == "terminal" ? "M 3 4 L 6.5 8 L 3 12 M 9 12 L 13 12" :
            root.name == "warning" ? "M 8 2 L 14.5 13.5 L 1.5 13.5 Z M 8 6 L 8 9.5 M 8 12 L 8 12.1" :
            root.name == "restart" || root.name == "refresh" ? "M 14 8 A 6 6 0 1 1 12.24 3.76 L 14 5.33 M 14 2 L 14 5.33 L 10.67 5.33" :
            root.name == "sun" ? "M 11 8 A 3 3 0 1 1 10.99 8 M 8 1 L 8 3 M 8 13 L 8 15 M 1 8 L 3 8 M 13 8 L 15 8 M 3 3 L 4.4 4.4 M 11.6 11.6 L 13 13 M 3 13 L 4.4 11.6 M 11.6 4.4 L 13 3" :
            root.name == "moon" ? "M 12.5 11.5 A 6 6 0 0 1 4.5 3.5 A 6.5 6.5 0 1 0 12.5 11.5 Z" :
            root.name == "search" ? "M 7.5 2.5 A 5 5 0 1 0 7.5 12.5 A 5 5 0 1 0 7.5 2.5 M 11 11 L 14.5 14.5" :
            root.name == "cpu" ? "M 5 5 L 11 5 L 11 11 L 5 11 Z M 7 1 L 7 3 M 9 1 L 9 3 M 7 13 L 7 15 M 9 13 L 9 15 M 1 7 L 3 7 M 1 9 L 3 9 M 13 7 L 15 7 M 13 9 L 15 9 M 3 3 L 13 3 L 13 13 L 3 13 Z" :
            root.name == "memory" ? "M 3 4 L 13 4 L 13 12 L 3 12 Z M 5 6 L 5 10 M 8 6 L 8 10 M 11 6 L 11 10 M 2 6 L 3 6 M 2 10 L 3 10 M 13 6 L 14 6 M 13 10 L 14 10" :
            root.name == "branch" ? "M 4 2.5 A 1.5 1.5 0 1 0 4 5.5 A 1.5 1.5 0 1 0 4 2.5 M 12 10.5 A 1.5 1.5 0 1 0 12 13.5 A 1.5 1.5 0 1 0 12 10.5 M 4 5.5 L 4 10.5 M 4 10.5 A 3.5 3.5 0 0 0 7.5 7 L 12 7 M 12 2.5 A 1.5 1.5 0 1 0 12 5.5 A 1.5 1.5 0 1 0 12 2.5 M 12 7 L 12 5.5" :
            root.name == "close" ? "M 4 4 L 12 12 M 12 4 L 4 12" :
            "M 2.5 2.5 L 6.5 2.5 L 6.5 6.5 L 2.5 6.5 Z M 9.5 2.5 L 13.5 2.5 L 13.5 6.5 L 9.5 6.5 Z M 2.5 9.5 L 6.5 9.5 L 6.5 13.5 L 2.5 13.5 Z M 9.5 9.5 L 13.5 9.5 L 13.5 13.5 L 9.5 13.5 Z";
        fill: root.filled ? root.tone : transparent;
        stroke: root.filled ? transparent : root.tone;
        stroke-width: root.name == "grid" ? 1.3px : 1.6px;
    }
}

component IconButton inherits Rectangle {
    in property <string> glyph: "grid";
    in property <string> tooltip: "";
    in property <color> tone: Theme.text-secondary;
    in property <bool> active: true;
    in property <length> size: 32px;
    out property <bool> has-focus: focus.has-focus;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: Theme.radius-sm;
    background: root.active ? root.tone.with-alpha(0.06) : Theme.overlay-hover;
    border-width: 1px;
    border-color: root.active ? root.tone.with-alpha(0.13) : Theme.border-soft;
    forward-focus: focus;
    accessible-role: button;
    accessible-enabled: root.active;
    accessible-label: root.tooltip;
    accessible-action-default => { if root.active { root.clicked(); } }
    animate background, border-color { duration: 120ms; }

    AppIcon {
        name: root.glyph;
        tone: root.active ? root.tone : Theme.text-muted;
        icon-size: root.size <= 28px ? 13px : 15px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea {
        enabled: root.active;
        mouse-cursor: root.active ? pointer : default;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        width: 0px;
        enabled: root.active;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if root.has-focus && root.active: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-md;
        border-width: 2px;
        border-color: Theme.accent.with-alpha(0.72);
    }
    states [
        pressed when ta.pressed && root.active: {
            background: root.tone.with-alpha(0.24);
            border-color: root.tone.with-alpha(0.36);
        }
        hover when ta.has-hover && root.active: {
            background: root.tone.with-alpha(0.15);
            border-color: root.tone.with-alpha(0.28);
        }
    ]
    Tooltip { text: @markdown("\{root.tooltip}"); }
}

component NavItem inherits Rectangle {
    in property <string> glyph: "grid";
    in property <string> label: "";
    in property <int> count: 0;
    in property <bool> selected: false;
    out property <bool> has-focus: focus.has-focus;
    callback clicked;
    height: 38px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.accent-soft : transparent;
    border-width: 1px;
    border-color: root.selected ? Theme.accent.with-alpha(0.20) : transparent;
    forward-focus: focus;
    accessible-role: button;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-label: root.label + " " + root.count;
    accessible-action-default => { root.clicked(); }
    animate background, border-color { duration: 120ms; }

    Rectangle {
        visible: root.selected;
        x: 0px;
        y: 9px;
        width: 3px;
        height: 20px;
        border-radius: 2px;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 9px;
        cross-axis-alignment: center;
        AppIcon {
            name: root.glyph;
            tone: root.selected ? Theme.accent : Theme.text-muted;
            icon-size: 16px;
        }
        Text {
            text: root.label;
            color: root.selected ? Theme.text : Theme.text-secondary;
            font-size: Theme.font-sm;
            font-weight: root.selected ? 500 : 400;
            horizontal-stretch: 1;
            min-width: 0px;
            overflow: elide;
        }
        Text {
            text: "" + root.count;
            color: root.selected ? Theme.accent : Theme.text-muted;
            font-size: Theme.font-xs;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if root.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-md;
        border-width: 2px;
        border-color: Theme.accent.with-alpha(0.72);
    }
    states [
        pressed when ta.pressed && !root.selected: { background: Theme.accent-soft; }
        hover when ta.has-hover && !root.selected: { background: Theme.panel-hover; }
    ]
}

component SegmentButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    in property <bool> underline: false;
    in property <length> button-width: 64px;
    out property <bool> has-focus: focus.has-focus;
    callback clicked;
    width: root.button-width;
    height: root.underline ? 38px : 30px;
    border-radius: root.underline ? 0px : Theme.radius-sm;
    background: !root.underline && root.selected ? Theme.panel-raised : transparent;
    border-width: root.underline ? 0px : 1px;
    border-color: !root.underline && root.selected ? Theme.border-strong : transparent;
    forward-focus: focus;
    accessible-role: button;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    animate background, border-color { duration: 120ms; }

    Text {
        text: root.label;
        color: root.selected ? Theme.text : Theme.text-muted;
        font-size: Theme.font-sm;
        font-weight: root.selected ? 500 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
        overflow: elide;
        accessible-role: none;
    }
    Rectangle {
        visible: root.selected;
        x: root.underline ? 0px : (parent.width - 18px) / 2;
        y: parent.height - 2px;
        width: root.underline ? parent.width : 18px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if root.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-md;
        border-width: 2px;
        border-color: Theme.accent.with-alpha(0.72);
    }
    states [
        pressed when ta.pressed && !root.selected: { background: Theme.accent-soft; }
        hover when ta.has-hover && !root.selected: { background: Theme.panel-hover; }
    ]
}

component TextButton inherits Rectangle {
    in property <string> label: "";
    in property <color> tone: Theme.accent;
    in property <bool> active: true;
    out property <bool> has-focus: focus.has-focus;
    callback clicked;
    height: 28px;
    border-radius: Theme.radius-sm;
    horizontal-stretch: 0;
    forward-focus: focus;
    accessible-role: button;
    accessible-enabled: root.active;
    accessible-label: root.label;
    accessible-action-default => { if root.active { root.clicked(); } }
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        cross-axis-alignment: center;
        Text {
            text: root.label;
            color: root.active ? root.tone : Theme.text-muted;
            font-size: Theme.font-xs;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        enabled: root.active;
        mouse-cursor: root.active ? pointer : default;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        width: 0px;
        enabled: root.active;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if root.has-focus && root.active: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-md;
        border-width: 2px;
        border-color: Theme.accent.with-alpha(0.72);
    }
    states [
        pressed when ta.pressed && root.active: { background: Theme.accent-soft; }
        hover when ta.has-hover && root.active: { background: Theme.panel-hover; }
    ]
}

component EmptyState inherits VerticalLayout {
    in property <string> glyph: "grid";
    in property <string> title: "";
    in property <string> detail: "";
    alignment: center;
    cross-axis-alignment: center;
    spacing: Theme.space-2;
    horizontal-stretch: 1;

    Rectangle {
        width: 44px;
        height: 44px;
        border-radius: Theme.radius-lg;
        background: Theme.accent-soft;
        AppIcon {
            name: root.glyph;
            tone: Theme.accent;
            icon-size: 22px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    Text { text: root.title; color: Theme.text-secondary; font-size: Theme.font-md; horizontal-alignment: center; }
    Text {
        text: root.detail;
        color: Theme.text-muted;
        font-size: Theme.font-xs;
        horizontal-alignment: center;
        horizontal-stretch: 1;
        max-width: 320px;
        wrap: word-wrap;
    }
}

component MetricTile inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "—";
    in property <string> unit: "";
    in property <string> caption: "";
    in property <string> glyph: "";
    in property <bool> embedded: false;
    in property <color> tone: Theme.accent;
    in property <[MetricPoint]> history: [];
    height: 118px;
    min-width: 0px;
    horizontal-stretch: 1;
    border-radius: root.embedded ? 0px : Theme.radius-md;
    background: root.embedded ? transparent : Theme.panel-raised;
    border-width: root.embedded ? 0px : 1px;
    border-color: Theme.border-soft;

    VerticalLayout {
        padding: root.embedded ? 12px : 14px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            cross-axis-alignment: center;
            if root.glyph != "": AppIcon {
                name: root.glyph;
                tone: Theme.text-muted;
                icon-size: 14px;
            }
            Text {
                text: root.label;
                color: Theme.text-secondary;
                font-size: Theme.font-xs;
                horizontal-stretch: 1;
                min-width: 0px;
                overflow: elide;
            }
            if !root.embedded: Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.tone; }
        }
        HorizontalLayout {
            spacing: 5px;
            cross-axis-alignment: end;
            Text { text: root.value; color: Theme.text; font-size: Theme.font-2xl; font-weight: 600; }
            Text { text: root.unit; color: Theme.text-muted; font-size: Theme.font-xs; vertical-alignment: bottom; }
        }
        if root.history.length > 0: HorizontalLayout {
            height: 30px;
            spacing: 2px;
            alignment: end;
            cross-axis-alignment: end;
            for point in root.history: Rectangle {
                horizontal-stretch: 1;
                min-width: 2px;
                max-width: 12px;
                height: 4px + point.value * 24px;
                border-radius: 2px;
                background: root.tone.with-alpha(0.38 + point.value * 0.45);
            }
        }
        if root.history.length == 0: Text {
            text: root.caption == "" ? "等待采样" : root.caption;
            color: Theme.text-muted;
            font-size: Theme.font-xs;
            min-width: 0px;
            overflow: elide;
        }
    }
}

component ServiceRow inherits Rectangle {
    in property <ServiceItem> item;
    in property <bool> selected: false;
    out property <bool> has-focus: focus.has-focus;
    callback select;
    height: 62px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.accent-soft : transparent;
    border-width: 0px;
    forward-focus: focus;
    accessible-role: list-item;
    accessible-label: root.item.name + "，" + Ui.state-label(root.item.state);
    accessible-action-default => { root.select(); }
    animate background, border-color { duration: 120ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.select(); }
    }
    Rectangle {
        visible: root.selected;
        x: 0px;
        y: 17px;
        width: 2px;
        height: 36px;
        border-radius: 2px;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 7px;
        spacing: 8px;
        cross-axis-alignment: center;
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: Ui.kind-tone(root.item.kind).with-alpha(0.10);
            AppIcon {
                name: Ui.kind-glyph(root.item.kind);
                tone: Ui.kind-tone(root.item.kind);
                icon-size: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            alignment: center;
            Text {
                text: root.item.name;
                color: Theme.text;
                font-size: Theme.font-sm;
                font-weight: 500;
                min-width: 0px;
                overflow: elide;
            }
            Text {
                text: root.item.subtitle;
                color: Theme.text-muted;
                font-size: Theme.font-xs;
                min-width: 0px;
                overflow: elide;
            }
        }
        HorizontalLayout {
            spacing: 6px;
            cross-axis-alignment: center;
            StatusDot { tone: Ui.state-tone(root.item.state); width: 7px; height: 7px; }
            Text {
                text: Ui.state-label(root.item.state);
                color: Theme.text-secondary;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
        }
    }
    focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.select();
                return accept;
            }
            return reject;
        }
    }
    if root.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-md;
        border-width: 2px;
        border-color: Theme.accent.with-alpha(0.72);
    }
    states [
        pressed when ta.pressed && !root.selected: { background: Theme.accent-soft; }
        hover when ta.has-hover && !root.selected: { background: Theme.panel-hover; }
    ]
}

component LogRow inherits HorizontalLayout {
    in property <LogLine> line;
    padding-top: 2px;
    padding-bottom: 2px;
    spacing: 10px;
    cross-axis-alignment: start;
    Text { text: root.line.time; color: Theme.text-muted; font-family: Theme.mono-font; font-size: Theme.font-xs; width: 62px; }
    Text { text: Ui.log-label(root.line.level); color: Ui.log-tone(root.line.level); font-size: Theme.font-xs; width: 34px; }
    Text {
        text: root.line.message;
        color: Theme.log-text;
        font-family: Theme.mono-font;
        font-size: Theme.font-sm;
        horizontal-stretch: 1;
        min-width: 0px;
        wrap: word-wrap;
    }
}

component Toast inherits Rectangle {
    in property <string> message: "";
    in property <color> tone: Theme.accent;
    height: 44px;
    border-radius: Theme.radius-md;
    background: Theme.panel-raised;
    border-width: 1px;
    border-color: root.tone.with-alpha(0.35);
    drop-shadow-color: Theme.shadow;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 4px;
    HorizontalLayout {
        padding-left: 13px;
        padding-right: 13px;
        spacing: 9px;
        cross-axis-alignment: center;
        StatusDot { tone: root.tone; }
        Text {
            text: root.message;
            color: Theme.text;
            font-size: Theme.font-sm;
            horizontal-stretch: 1;
            min-width: 0px;
            overflow: elide;
        }
    }
}

export { StatusDot, AppIcon, IconButton, NavItem, SegmentButton, TextButton, EmptyState, MetricTile, ServiceRow, LogRow, Toast }
