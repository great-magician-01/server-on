import { Button, LineEdit, ListView, ScrollView, SpinBox, Switch, TextEdit, Palette } from "std-widgets.slint";
import { Theme, Ui } from "theme.slint";
import { ServiceItem, DistributionItem, LogLine, ServiceConfig, MetricPoint } from "models.slint";
import { StatusDot, AppIcon, IconButton, NavItem, SegmentButton, TextButton, EmptyState, MetricTile, ServiceRow, LogRow, Toast } from "components.slint";

export { ServiceItem, DistributionItem, LogLine, ServiceConfig, MetricPoint } from "models.slint";
export { AppTray } from "tray.slint";

export component AppWindow inherits Window {
    title: "ServerOn · 本地服务管理器";
    icon: @image-url("../../../assets/icon/server-on-256.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.bg;
    default-font-family: Theme.ui-font;
    default-font-size: Theme.font-sm;

    in-out property <[ServiceItem]> services: [];
    in-out property <[DistributionItem]> distributions: [];
    in-out property <[LogLine]> logs: [];
    in-out property <[LogLine]> recent-logs: [];
    in-out property <int> log-count: 0;
    in-out property <int> log-generation: 0;
    in-out property <int> log-epoch: 0;
    in-out property <ServiceConfig> selected-service: {
        id: "", name: "未选择服务", runtime-kind: "", type-label: "", origin-label: "",
        state: "unknown", health: "not-configured", detail: "", status-message: "",
        distribution: "", working-directory: "", shell: "PowerShell", script: "", environment: "",
        health-check-kind: "none", health-target: "", stop-timeout: 10, auto-start: false,
        restart-policy: "不自动重启", ports: "", pid: "—", uptime: "—", cpu: "—", memory: "—",
    };
    in-out property <string> selected-service-id: "";
    in-out property <string> active-filter: "all";
    in-out property <string> search-text: "";
    in-out property <int> visible-service-count: 0;
    in-out property <int> running-count: 0;
    in-out property <int> issue-count: 0;
    in-out property <int> stopped-count: 0;
    in-out property <int> windows-count: 0;
    in-out property <int> container-count: 0;
    in-out property <bool> discovery-running: false;
    in-out property <string> discovery-summary: "等待自动发现";
    in-out property <string> last-discovery: "尚未扫描";
    in-out property <bool> daemon-connected: false;
    in-out property <string> daemon-status: "正在连接守护进程…";
    in-out property <string> app-version: "0.1.0";
    in-out property <bool> config-dirty: false;
    in-out property <bool> config-saving: false;

    in-out property <bool> dark-theme: true;
    in-out property <bool> close-to-tray: true;
    in-out property <string> active-tab: "overview";
    in-out property <string> selected-cpu: "—";
    in-out property <string> selected-memory: "—";
    in-out property <string> selected-uptime: "—";
    in-out property <int> selected-process-count: 0;
    in-out property <[MetricPoint]> cpu-history: [];
    in-out property <[MetricPoint]> memory-history: [];
    in-out property <string> metrics-message: "";
    in-out property <string> metrics-sampled-at: "";
    in-out property <bool> log-follow: true;
    in-out property <string> log-filter: "";
    in-out property <string> log-stream-filter: "all";
    in-out property <string> toast-text: "";
    in-out property <string> toast-kind: "info";
    in-out property <bool> toast-visible: false;

    callback select-service(id: string);
    callback start-service(id: string);
    callback stop-service(id: string);
    callback restart-service(id: string);
    callback refresh-discovery();
    callback save-service(config: ServiceConfig);
    callback create-service(kind: string);
    callback search-changed(query: string);
    callback filter-changed(filter: string);
    callback clear-logs();
    callback toggle-theme(dark: bool);
    callback tab-changed(tab: string);
    callback log-follow-toggled(follow: bool);
    callback log-filter-changed(text: string);
    callback log-stream-changed(stream: string);
    callback dismiss-toast();

    function service-visible(state: string, matches-search: bool) -> bool {
        if !matches-search { return false; }
        if root.active-filter == "running" { return state == "running" || state == "degraded" || state == "starting" || state == "stopping"; }
        if root.active-filter == "issues" { return state == "failed" || state == "degraded" || state == "unknown" || state == "missing"; }
        if root.active-filter == "stopped" { return state == "stopped"; }
        return true;
    }
    function select-filter(filter: string) {
        root.active-filter = filter;
        root.filter-changed(filter);
    }
    function select-service-row(id: string) {
        root.selected-service-id = id;
        root.select-service(id);
    }
    function set-tab(tab: string) {
        root.active-tab = tab;
        root.tab-changed(tab);
    }
    function create-draft(kind: string) {
        root.create-menu-open = false;
        root.set-tab("config");
        root.create-service(kind);
    }
    function set-log-stream(stream: string) {
        root.log-stream-filter = stream;
        root.log-stream-changed(stream);
    }
    function update-layout-metrics() {
        root.compact = root.width > 0px && root.width < 1240px;
        root.dense = root.compact || (root.height > 0px && root.height < 760px);
    }

    private property <bool> compact: false;
    private property <bool> dense: false;
    private property <bool> create-menu-open: false;
    private property <length> sidebar-width: root.compact ? 176px : 196px;
    private property <length> list-width: root.compact ? 256px : 286px;
    private property <length> workspace-padding: root.compact ? 14px : 20px;
    private property <length> workspace-gap: root.compact ? 12px : 16px;
    private property <length> content-max: 1560px;
    private property <length> header-height: root.compact ? 58px : 64px;
    private property <length> status-height: 28px;
    private property <length> detail-header-height: root.dense ? 68px : 76px;
    private property <length> metric-height: root.dense ? 96px : 108px;
    private property <length> config-side-width: root.compact ? 140px : 180px;

    init => {
        root.update-layout-metrics();
        Theme.dark = root.dark-theme;
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
    }
    changed width => { root.update-layout-metrics(); }
    changed height => { root.update-layout-metrics(); }
    changed dark-theme => {
        Theme.dark = root.dark-theme;
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        VerticalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;
            Rectangle {
                height: root.header-height;
                background: Theme.surface;
                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: root.compact ? 14px : 16px;
                    padding-right: root.compact ? 14px : 16px;
                    spacing: 12px;
                    cross-axis-alignment: center;
                    Image {
                        width: 36px;
                        height: 36px;
                        source: @image-url("../../../assets/icon/server-on-256.png");
                        image-fit: contain;
                    }
                    VerticalLayout {
                        spacing: 1px;
                        alignment: center;
                        Text { text: "ServerOn"; color: Theme.text; font-size: 16px; font-weight: 500; }
                        if !root.compact: Text { text: "本地服务控制台"; color: Theme.text-muted; font-size: Theme.font-xs; }
                    }
                    Rectangle {
                        width: root.compact ? 220px : 360px;
                        height: 36px;
                        HorizontalLayout {
                            width: parent.width;
                            height: parent.height;
                            spacing: 7px;
                            cross-axis-alignment: center;
                            AppIcon { name: "search"; tone: Theme.text-muted; icon-size: 16px; }
                            LineEdit {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                height: 34px;
                                text <=> root.search-text;
                                placeholder-text: root.compact ? "搜索服务" : "搜索服务、容器或发行版";
                                edited(query) => { root.search-changed(query); }
                            }
                            if root.search-text != "": IconButton {
                                glyph: "close";
                                tooltip: "清除搜索";
                                size: 28px;
                                clicked => {
                                    root.search-text = "";
                                    root.search-changed("");
                                }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; min-width: 8px; }
                    IconButton {
                        glyph: "refresh";
                        tooltip: root.discovery-running ? "正在扫描环境" : "刷新自动发现";
                        tone: Theme.text-secondary;
                        size: 34px;
                        active: !root.discovery-running;
                        clicked => { root.refresh-discovery(); }
                    }
                    IconButton {
                        glyph: root.dark-theme ? "sun" : "moon";
                        tooltip: root.dark-theme ? "切换浅色主题" : "切换深色主题";
                        tone: Theme.text-secondary;
                        size: 34px;
                        clicked => {
                            root.dark-theme = !root.dark-theme;
                            root.toggle-theme(root.dark-theme);
                        }
                    }
                    Button {
                        width: root.compact ? 92px : 116px;
                        height: 34px;
                        text: root.compact ? "+ 新建" : "+ 新建服务";
                        primary: true;
                        clicked => { root.create-menu-open = !root.create-menu-open; }
                    }
                }
                Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;
                Rectangle {
                    width: root.sidebar-width;
                    background: Theme.sidebar;
                    VerticalLayout {
                        padding: root.compact ? 12px : 14px;
                        spacing: 6px;
                        Text { text: "工作台"; color: Theme.text-muted; font-size: Theme.font-xs; font-weight: 600; }
                        for item in [
                            {label: "全部服务", filter: "all", count: root.services.length, glyph: "grid"},
                            {label: "运行中", filter: "running", count: root.running-count, glyph: "play"},
                            {label: "需要关注", filter: "issues", count: root.issue-count, glyph: "warning"},
                            {label: "已停止", filter: "stopped", count: root.stopped-count, glyph: "stop"},
                        ]: NavItem {
                            label: item.label;
                            glyph: item.glyph;
                            count: item.count;
                            selected: root.active-filter == item.filter;
                            clicked => { root.select-filter(item.filter); }
                        }
                        Rectangle { height: 8px; }
                        Text { text: "运行环境"; color: Theme.text-muted; font-size: Theme.font-xs; font-weight: 600; }
                        ScrollView {
                            vertical-stretch: 1;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            VerticalLayout {
                                spacing: 6px;
                                for distro in root.distributions: Rectangle {
                                    height: root.dense ? 52px : 58px;
                                    border-radius: Theme.radius-sm;
                                    background: transparent;
                                    VerticalLayout {
                                        padding: 9px;
                                        spacing: 5px;
                                        HorizontalLayout {
                                            spacing: 7px;
                                            cross-axis-alignment: center;
                                            StatusDot { tone: Ui.state-tone(distro.state); }
                                            Text {
                                                text: distro.name;
                                                color: Theme.text-secondary;
                                                font-size: Theme.font-sm;
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                                overflow: elide;
                                            }
                                            Text { text: distro.version; color: Theme.text-muted; font-size: Theme.font-xs; }
                                        }
                                        HorizontalLayout {
                                            spacing: 7px;
                                            cross-axis-alignment: center;
                                            StatusDot { tone: Ui.engine-tone(distro.engine-state); }
                                            Text {
                                                text: distro.engine-label;
                                                color: Theme.text-muted;
                                                font-size: Theme.font-xs;
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                                overflow: elide;
                                            }
                                            Text { text: distro.container-count + " 个"; color: Theme.text-muted; font-size: Theme.font-xs; }
                                        }
                                    }
                                }
                                if root.distributions.length == 0: Text {
                                    text: "尚未发现 WSL 环境";
                                    color: Theme.text-muted;
                                    font-size: Theme.font-xs;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        Rectangle {
                            height: root.dense ? 64px : 72px;
                            border-radius: Theme.radius-md;
                            background: transparent;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    cross-axis-alignment: center;
                                    StatusDot { tone: root.discovery-running ? Theme.info : root.daemon-connected ? Theme.success : Theme.danger; }
                                    Text {
                                        text: root.discovery-running ? "正在扫描环境" : "自动发现已启用";
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-xs;
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        overflow: elide;
                                    }
                                }
                                Text {
                                    text: root.discovery-summary;
                                    color: Theme.text-muted;
                                    font-size: Theme.font-xs;
                                    min-width: 0px;
                                    overflow: elide;
                                }
                                if !root.dense: Text { text: "WSL · Docker Engine"; color: Theme.text-muted; font-size: Theme.font-xs; }
                            }
                        }
                    }
                    Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.border-soft; }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;
                    workspace := Rectangle {
                        y: root.workspace-padding;
                        width: min(parent.width - 2 * root.workspace-padding, root.content-max);
                        height: parent.height - 2 * root.workspace-padding;
                        x: min(96px, max(root.workspace-padding, (parent.width - self.width) / 2));
                        VerticalLayout {
                            spacing: root.workspace-gap;
                            HorizontalLayout {
                                height: root.dense ? 44px : 48px;
                                spacing: 10px;
                                cross-axis-alignment: center;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    alignment: center;
                                    Text {
                                        text: "服务概览";
                                        color: Theme.text;
                                        font-size: root.compact ? Theme.font-xl : 22px;
                                        font-weight: 500;
                                    }
                                    Text {
                                        text: root.services.length + " 个服务 · " + root.running-count + " 个运行中 · " + root.issue-count + " 个需要关注";
                                        color: Theme.text-muted;
                                        font-size: Theme.font-xs;
                                        min-width: 0px;
                                        overflow: elide;
                                    }
                                }
                                if !root.compact: Text { text: "Windows · WSL · Docker"; color: Theme.text-muted; font-size: Theme.font-xs; }
                            }

                            HorizontalLayout {
                                vertical-stretch: 1;
                                spacing: root.workspace-gap;
                                Rectangle {
                                    width: root.list-width;
                                    border-radius: Theme.radius-lg;
                                    background: Theme.panel;
                                    border-width: 1px;
                                    border-color: Theme.border-soft;
                                    VerticalLayout {
                                        Rectangle {
                                            height: 48px;
                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 14px;
                                                cross-axis-alignment: center;
                                                Text { text: "服务列表"; color: Theme.text; font-size: Theme.font-md; font-weight: 600; horizontal-stretch: 1; }
                                                Text { text: root.visible-service-count + " 项"; color: Theme.text-muted; font-size: Theme.font-xs; }
                                            }
                                        }
                                        Rectangle { height: 1px; background: Theme.border-soft; }
                                        ScrollView {
                                            vertical-stretch: 1;
                                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                            VerticalLayout {
                                                padding: 7px;
                                                spacing: 4px;
                                                for svc in root.services: ServiceRow {
                                                    visible: root.service-visible(svc.state, svc.matches-search);
                                                    item: svc;
                                                    selected: root.selected-service-id == svc.id;
                                                    height: root.dense ? 58px : 62px;
                                                    select => { root.select-service-row(svc.id); }
                                                }
                                                if root.visible-service-count == 0: EmptyState {
                                                    height: 180px;
                                                    glyph: "grid";
                                                    title: root.services.length == 0 ? "还没有服务" : "没有匹配的服务";
                                                    detail: root.services.length == 0 ? "新建 Windows / WSL 服务，或刷新自动发现已有容器。" : "调整搜索或筛选条件后再试。";
                                                }
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    border-radius: Theme.radius-lg;
                                    background: Theme.panel;
                                    border-width: 1px;
                                    border-color: Theme.border-soft;
                                    VerticalLayout {
                                        Rectangle {
                                            height: root.detail-header-height;
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 12px;
                                                spacing: 10px;
                                                cross-axis-alignment: center;
                                                Rectangle {
                                                    width: 38px;
                                                    height: 38px;
                                                    border-radius: Theme.radius-md;
                                                    background: Ui.kind-tone(root.selected-service.runtime-kind).with-alpha(0.10);
                                                    AppIcon {
                                                        name: Ui.kind-glyph(root.selected-service.runtime-kind);
                                                        tone: Ui.kind-tone(root.selected-service.runtime-kind);
                                                        icon-size: 18px;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                }
                                                VerticalLayout {
                                                    min-width: 0px;
                                                    horizontal-stretch: 1;
                                                    spacing: 3px;
                                                    alignment: center;
                                                    Text {
                                                        text: root.selected-service.name == "" ? "未选择服务" : root.selected-service.name;
                                                        color: Theme.text;
                                                        font-size: Theme.font-lg;
                                                        font-weight: 500;
                                                        min-width: 0px;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: root.selected-service.id == "" ? "选择服务以查看详情" : root.selected-service.type-label + " · " + root.selected-service.origin-label;
                                                        color: Theme.text-muted;
                                                        font-size: Theme.font-xs;
                                                        min-width: 0px;
                                                        overflow: elide;
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    cross-axis-alignment: center;
                                                    StatusDot { tone: Ui.state-tone(root.selected-service.state); width: 7px; height: 7px; }
                                                    Text {
                                                        text: Ui.state-label(root.selected-service.state);
                                                        color: Theme.text-secondary;
                                                        font-size: Theme.font-xs;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                if root.selected-service.state == "stopped" || root.selected-service.state == "failed": Button {
                                                    width: 76px;
                                                    height: 34px;
                                                    text: "启动服务";
                                                    primary: true;
                                                    clicked => { root.start-service(root.selected-service.id); }
                                                }
                                                if root.selected-service.state == "running" || root.selected-service.state == "degraded": Button {
                                                    width: 62px;
                                                    height: 34px;
                                                    text: "停止";
                                                    clicked => { root.stop-service(root.selected-service.id); }
                                                }
                                                if root.selected-service.state == "running" || root.selected-service.state == "degraded" || root.selected-service.state == "failed": Button {
                                                    width: 62px;
                                                    height: 34px;
                                                    text: "重启";
                                                    primary: true;
                                                    clicked => { root.restart-service(root.selected-service.id); }
                                                }
                                            }
                                        }
                                        Rectangle { height: 1px; background: Theme.border-soft; }
                                        Rectangle {
                                            height: root.dense ? 40px : 44px;
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                spacing: 22px;
                                                cross-axis-alignment: center;
                                                SegmentButton {
                                                    label: "概览";
                                                    button-width: 44px;
                                                    underline: true;
                                                    selected: root.active-tab == "overview";
                                                    clicked => { root.set-tab("overview"); }
                                                }
                                                SegmentButton {
                                                    label: "配置";
                                                    button-width: 44px;
                                                    underline: true;
                                                    selected: root.active-tab == "config";
                                                    clicked => { root.set-tab("config"); }
                                                }
                                                SegmentButton {
                                                    label: "日志";
                                                    button-width: 44px;
                                                    underline: true;
                                                    selected: root.active-tab == "logs";
                                                    clicked => { root.set-tab("logs"); }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                            Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border-soft; }
                                        }

                                        if root.active-tab == "overview": ScrollView {
                                            vertical-stretch: 1;
                                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                            VerticalLayout {
                                                padding: root.dense ? 12px : 16px;
                                                spacing: root.dense ? 12px : 14px;
                                                Rectangle {
                                                    height: root.metric-height;
                                                    border-radius: Theme.radius-md;
                                                    background: Theme.panel-raised;
                                                    border-width: 1px;
                                                    border-color: Theme.border-soft;
                                                    HorizontalLayout {
                                                        spacing: 0px;
                                                        cross-axis-alignment: center;
                                                        MetricTile {
                                                            label: "CPU 使用率";
                                                            glyph: "cpu";
                                                            embedded: true;
                                                            value: root.selected-cpu;
                                                            unit: root.selected-cpu == "—" ? "" : "%";
                                                            history: root.cpu-history;
                                                            tone: Theme.accent;
                                                            caption: root.metrics-message;
                                                            height: root.metric-height;
                                                        }
                                                        Rectangle { width: 1px; height: root.metric-height - 24px; background: Theme.border-soft; }
                                                        MetricTile {
                                                            label: "内存占用";
                                                            glyph: "memory";
                                                            embedded: true;
                                                            value: root.selected-memory;
                                                            unit: root.selected-memory == "—" ? "" : "MB";
                                                            history: root.memory-history;
                                                            tone: Theme.accent;
                                                            caption: root.metrics-message;
                                                            height: root.metric-height;
                                                        }
                                                        Rectangle { width: 1px; height: root.metric-height - 24px; background: Theme.border-soft; }
                                                        MetricTile {
                                                            label: "进程 / 线程";
                                                            glyph: "branch";
                                                            embedded: true;
                                                            value: root.selected-process-count == 0 ? "—" : "" + root.selected-process-count;
                                                            unit: root.selected-process-count == 0 ? "" : "个";
                                                            history: [];
                                                            tone: Theme.accent;
                                                            caption: "运行时长 · " + root.selected-uptime;
                                                            height: root.metric-height;
                                                        }
                                                    }
                                                }
                                                Rectangle {
                                                    height: root.dense ? 68px : 76px;
                                                    vertical-stretch: 0;
                                                    background: transparent;
                                                    VerticalLayout {
                                                        padding-left: 2px;
                                                        padding-right: 2px;
                                                        spacing: 6px;
                                                        HorizontalLayout {
                                                            spacing: 14px;
                                                            Text { text: "PID / 容器"; color: Theme.text-muted; font-size: Theme.font-xs; width: 70px; }
                                                            Text {
                                                                text: root.selected-service.pid;
                                                                color: Theme.text-secondary;
                                                                font-size: Theme.font-sm;
                                                                horizontal-stretch: 1;
                                                                min-width: 0px;
                                                                overflow: elide;
                                                            }
                                                            Text { text: "端口"; color: Theme.text-muted; font-size: Theme.font-xs; width: 36px; }
                                                            Text {
                                                                text: root.selected-service.ports == "" ? "—" : root.selected-service.ports;
                                                                color: Theme.text-secondary;
                                                                font-size: Theme.font-sm;
                                                                horizontal-stretch: 1;
                                                                min-width: 0px;
                                                                overflow: elide;
                                                            }
                                                        }
                                                        HorizontalLayout {
                                                            spacing: 14px;
                                                            Text { text: "发行版"; color: Theme.text-muted; font-size: Theme.font-xs; width: 70px; }
                                                            Text {
                                                                text: root.selected-service.distribution == "" ? "Windows" : root.selected-service.distribution;
                                                                color: Theme.text-secondary;
                                                                font-size: Theme.font-sm;
                                                                horizontal-stretch: 1;
                                                                min-width: 0px;
                                                                overflow: elide;
                                                            }
                                                            Text { text: "健康"; color: Theme.text-muted; font-size: Theme.font-xs; width: 36px; }
                                                            Text {
                                                                text: Ui.health-label(root.selected-service.health);
                                                                color: Ui.health-tone(root.selected-service.health);
                                                                font-size: Theme.font-sm;
                                                                horizontal-stretch: 1;
                                                                min-width: 0px;
                                                                overflow: elide;
                                                            }
                                                        }
                                                        Text {
                                                            text: root.selected-service.status-message == "" ? root.metrics-message : root.selected-service.status-message;
                                                            color: Theme.text-muted;
                                                            font-size: Theme.font-xs;
                                                            horizontal-stretch: 1;
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                }
                                                Rectangle {
                                                    vertical-stretch: 1;
                                                    min-height: root.dense ? 170px : 200px;
                                                    border-radius: Theme.radius-md;
                                                    background: Theme.log-bg;
                                                    border-width: 1px;
                                                    border-color: Theme.border-soft;
                                                    VerticalLayout {
                                                        spacing: 0px;
                                                        Rectangle {
                                                            height: 40px;
                                                            background: Theme.panel-raised;
                                                            HorizontalLayout {
                                                                padding-left: 12px;
                                                                padding-right: 12px;
                                                                cross-axis-alignment: center;
                                                                Text { text: "最近日志"; color: Theme.text; font-size: Theme.font-md; font-weight: 500; horizontal-stretch: 1; }
                                                                TextButton { label: "查看全部 ›"; clicked => { root.set-tab("logs"); } }
                                                            }
                                                        }
                                                        Rectangle { height: 1px; background: Theme.border-soft; }
                                                        VerticalLayout {
                                                            padding: 12px;
                                                            spacing: 7px;
                                                            for line in root.recent-logs: LogRow { line: line; }
                                                            if root.recent-logs.length == 0: EmptyState {
                                                                height: 116px;
                                                                glyph: "terminal";
                                                                title: root.log-count == 0 ? "暂无日志" : "没有匹配的日志";
                                                                detail: root.log-count == 0 ? "启动服务后，输出会显示在这里。" : "调整日志筛选条件后再试。";
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        if root.active-tab == "config": VerticalLayout {
                                            vertical-stretch: 1;
                                            ScrollView {
                                                vertical-stretch: 1;
                                                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                                VerticalLayout {
                                                    padding: root.dense ? 12px : 16px;
                                                    spacing: 14px;
                                                    if root.selected-service.runtime-kind == "container": Rectangle {
                                                        min-height: 190px;
                                                        border-radius: Theme.radius-md;
                                                        background: Theme.accent-soft;
                                                        border-width: 1px;
                                                        border-color: Theme.accent.with-alpha(0.20);
                                                        VerticalLayout {
                                                            padding: 16px;
                                                            spacing: 10px;
                                                            Text { text: "Docker 容器由 Engine 自动管理"; color: Theme.text; font-size: Theme.font-lg; font-weight: 600; }
                                                            Text {
                                                                text: "启动、停止和重启会直接作用于现有容器。镜像、端口、挂载和环境变量的修改需要在 Docker 工作流中完成，ServerOn 不会擅自重建容器。";
                                                                color: Theme.text-secondary;
                                                                font-size: Theme.font-sm;
                                                                horizontal-stretch: 1;
                                                                wrap: word-wrap;
                                                            }
                                                            Text {
                                                                text: "容器：" + root.selected-service.name + "\n发行版：" + root.selected-service.distribution + "\n镜像：" + root.selected-service.detail;
                                                                color: Theme.text-muted;
                                                                font-size: Theme.font-xs;
                                                                horizontal-stretch: 1;
                                                                wrap: word-wrap;
                                                            }
                                                        }
                                                    }
                                                    if root.selected-service.runtime-kind != "container": VerticalLayout {
                                                        spacing: 14px;
                                                        Rectangle {
                                                            border-radius: Theme.radius-md;
                                                            background: Theme.panel-raised;
                                                            border-width: 1px;
                                                            border-color: Theme.border-soft;
                                                            VerticalLayout {
                                                                padding: 14px;
                                                                spacing: 12px;
                                                                Text { text: "基本信息"; color: Theme.text; font-size: Theme.font-md; font-weight: 600; }
                                                                HorizontalLayout {
                                                                    spacing: 12px;
                                                                    VerticalLayout {
                                                                        horizontal-stretch: 1;
                                                                        spacing: 5px;
                                                                        Text { text: "服务名称"; color: Theme.text-secondary; font-size: Theme.font-xs; }
                                                                        LineEdit {
                                                                            height: 34px;
                                                                            text <=> root.selected-service.name;
                                                                            edited(_) => { root.config-dirty = true; }
                                                                        }
                                                                    }
                                                                    VerticalLayout {
                                                                        width: root.config-side-width;
                                                                        spacing: 5px;
                                                                        Text { text: "运行 Shell"; color: Theme.text-secondary; font-size: Theme.font-xs; }
                                                                        LineEdit {
                                                                            height: 34px;
                                                                            text <=> root.selected-service.shell;
                                                                            enabled: root.selected-service.runtime-kind == "windows";
                                                                            edited(_) => { root.config-dirty = true; }
                                                                        }
                                                                    }
                                                                }
                                                                HorizontalLayout {
                                                                    spacing: 12px;
                                                                    VerticalLayout {
                                                                        horizontal-stretch: 1;
                                                                        spacing: 5px;
                                                                        Text { text: "工作目录"; color: Theme.text-secondary; font-size: Theme.font-xs; }
                                                                        LineEdit {
                                                                            height: 34px;
                                                                            text <=> root.selected-service.working-directory;
                                                                            edited(_) => { root.config-dirty = true; }
                                                                        }
                                                                    }
                                                                    VerticalLayout {
                                                                        width: root.config-side-width;
                                                                        spacing: 5px;
                                                                        Text { text: "WSL 发行版"; color: Theme.text-secondary; font-size: Theme.font-xs; }
                                                                        LineEdit {
                                                                            height: 34px;
                                                                            text <=> root.selected-service.distribution;
                                                                            enabled: root.selected-service.runtime-kind == "wsl";
                                                                            edited(_) => { root.config-dirty = true; }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        Rectangle {
                                                            border-radius: Theme.radius-md;
                                                            background: Theme.panel-raised;
                                                            border-width: 1px;
                                                            border-color: Theme.border-soft;
                                                            VerticalLayout {
                                                                padding: 14px;
                                                                spacing: 10px;
                                                                Text { text: "启动脚本"; color: Theme.text; font-size: Theme.font-md; font-weight: 600; }
                                                                TextEdit {
                                                                    height: root.dense ? 130px : 170px;
                                                                    text <=> root.selected-service.script;
                                                                    font-family: Theme.mono-font;
                                                                    font-size: Theme.font-sm;
                                                                    wrap: no-wrap;
                                                                    edited(_) => { root.config-dirty = true; }
                                                                }
                                                                Text {
                                                                    text: "长期服务请保持前台运行，不要使用 nohup、disown 或 & 脱离管理。保存后由 daemon 校验并应用配置。";
                                                                    color: Theme.text-muted;
                                                                    font-size: Theme.font-xs;
                                                                    horizontal-stretch: 1;
                                                                    wrap: word-wrap;
                                                                }
                                                            }
                                                        }
                                                        Rectangle {
                                                            border-radius: Theme.radius-md;
                                                            background: Theme.panel-raised;
                                                            border-width: 1px;
                                                            border-color: Theme.border-soft;
                                                            VerticalLayout {
                                                                padding: 14px;
                                                                spacing: 12px;
                                                                Text { text: "健康与重启"; color: Theme.text; font-size: Theme.font-md; font-weight: 600; }
                                                                HorizontalLayout {
                                                                    spacing: 12px;
                                                                    VerticalLayout {
                                                                        width: root.config-side-width;
                                                                        spacing: 5px;
                                                                        Text { text: "健康检查"; color: Theme.text-secondary; font-size: Theme.font-xs; }
                                                                        LineEdit {
                                                                            height: 34px;
                                                                            text <=> root.selected-service.health-check-kind;
                                                                            placeholder-text: "none / http / tcp";
                                                                            edited(_) => { root.config-dirty = true; }
                                                                        }
                                                                    }
                                                                    VerticalLayout {
                                                                        horizontal-stretch: 1;
                                                                        spacing: 5px;
                                                                        Text { text: "检查目标"; color: Theme.text-secondary; font-size: Theme.font-xs; }
                                                                        LineEdit {
                                                                            height: 34px;
                                                                            text <=> root.selected-service.health-target;
                                                                            placeholder-text: "http://127.0.0.1:8080/health 或 host:port";
                                                                            edited(_) => { root.config-dirty = true; }
                                                                        }
                                                                    }
                                                                }
                                                                HorizontalLayout {
                                                                    spacing: 16px;
                                                                    VerticalLayout {
                                                                        width: root.config-side-width;
                                                                        spacing: 5px;
                                                                        Text { text: "停止超时（秒）"; color: Theme.text-secondary; font-size: Theme.font-xs; }
                                                                        SpinBox {
                                                                            height: 34px;
                                                                            minimum: 1;
                                                                            maximum: 600;
                                                                            value <=> root.selected-service.stop-timeout;
                                                                            edited(_) => { root.config-dirty = true; }
                                                                        }
                                                                    }
                                                                    VerticalLayout {
                                                                        horizontal-stretch: 1;
                                                                        spacing: 5px;
                                                                        Text { text: "随 daemon 自动启动"; color: Theme.text-secondary; font-size: Theme.font-xs; }
                                                                        Switch {
                                                                            checked <=> root.selected-service.auto-start;
                                                                            toggled => { root.config-dirty = true; }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        Rectangle {
                                                            border-radius: Theme.radius-md;
                                                            background: Theme.panel-raised;
                                                            border-width: 1px;
                                                            border-color: Theme.border-soft;
                                                            VerticalLayout {
                                                                padding: 14px;
                                                                spacing: 10px;
                                                                Text { text: "环境变量"; color: Theme.text; font-size: Theme.font-md; font-weight: 600; }
                                                                Text { text: "每行一个 KEY=VALUE"; color: Theme.text-muted; font-size: Theme.font-xs; }
                                                                TextEdit {
                                                                    height: 90px;
                                                                    text <=> root.selected-service.environment;
                                                                    font-family: Theme.mono-font;
                                                                    font-size: Theme.font-sm;
                                                                    wrap: no-wrap;
                                                                    edited(_) => { root.config-dirty = true; }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            Rectangle {
                                                height: 54px;
                                                background: Theme.panel-raised;
                                                HorizontalLayout {
                                                    padding-left: 16px;
                                                    padding-right: 16px;
                                                    spacing: 12px;
                                                    cross-axis-alignment: center;
                                                    StatusDot { tone: root.config-dirty ? Theme.warning : Theme.text-muted; }
                                                    Text {
                                                        text: root.config-dirty ? "有未保存的更改" : "配置已同步";
                                                        color: root.config-dirty ? Theme.warning : Theme.text-muted;
                                                        font-size: Theme.font-xs;
                                                        horizontal-stretch: 1;
                                                        min-width: 0px;
                                                        overflow: elide;
                                                    }
                                                    Button {
                                                        width: 112px;
                                                        height: 34px;
                                                        text: root.config-saving ? "保存中…" : "保存更改";
                                                        primary: true;
                                                        enabled: root.selected-service.id != "" || root.config-dirty;
                                                        clicked => {
                                                            root.config-saving = true;
                                                            root.save-service(root.selected-service);
                                                        }
                                                    }
                                                }
                                                Rectangle { y: 0px; width: parent.width; height: 1px; background: Theme.border-soft; }
                                            }
                                        }

                                        if root.active-tab == "logs": VerticalLayout {
                                            vertical-stretch: 1;
                                            Rectangle {
                                                height: root.dense ? 90px : 92px;
                                                VerticalLayout {
                                                    padding: 10px;
                                                    spacing: 8px;
                                                    HorizontalLayout {
                                                        height: 32px;
                                                        spacing: 8px;
                                                        cross-axis-alignment: center;
                                                        LineEdit {
                                                            horizontal-stretch: 1;
                                                            height: 32px;
                                                            text <=> root.log-filter;
                                                            placeholder-text: "筛选日志内容";
                                                            edited(text) => { root.log-filter-changed(text); }
                                                        }
                                                        TextButton { label: "清空视图"; tone: Theme.text-secondary; clicked => { root.clear-logs(); } }
                                                    }
                                                    HorizontalLayout {
                                                        height: 30px;
                                                        spacing: 6px;
                                                        cross-axis-alignment: center;
                                                        SegmentButton {
                                                            label: "全部";
                                                            button-width: root.compact ? 48px : 56px;
                                                            selected: root.log-stream-filter == "all";
                                                            clicked => { root.set-log-stream("all"); }
                                                        }
                                                        SegmentButton {
                                                            label: "输出";
                                                            button-width: root.compact ? 48px : 56px;
                                                            selected: root.log-stream-filter == "stdout";
                                                            clicked => { root.set-log-stream("stdout"); }
                                                        }
                                                        SegmentButton {
                                                            label: "错误";
                                                            button-width: root.compact ? 48px : 56px;
                                                            selected: root.log-stream-filter == "stderr";
                                                            clicked => { root.set-log-stream("stderr"); }
                                                        }
                                                        SegmentButton {
                                                            label: "系统";
                                                            button-width: root.compact ? 48px : 56px;
                                                            selected: root.log-stream-filter == "system";
                                                            clicked => { root.set-log-stream("system"); }
                                                        }
                                                        SegmentButton {
                                                            label: root.log-follow ? "暂停" : "跟随";
                                                            button-width: root.compact ? 56px : 64px;
                                                            selected: root.log-follow;
                                                            clicked => {
                                                                root.log-follow = !root.log-follow;
                                                                if root.log-follow {
                                                                    logs-list.content-y = -100000px;
                                                                }
                                                                root.log-follow-toggled(root.log-follow);
                                                            }
                                                        }
                                                        Rectangle { horizontal-stretch: 1; }
                                                        Text { text: root.log-count + " 条"; color: Theme.text-muted; font-size: Theme.font-xs; }
                                                    }
                                                }
                                            }
                                            Rectangle { height: 1px; background: Theme.border-soft; }
                                            Rectangle {
                                                vertical-stretch: 1;
                                                background: Theme.log-bg;
                                                logs-list := ListView {
                                                    x: 0px;
                                                    y: 0px;
                                                    width: parent.width;
                                                    height: parent.height;
                                                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                                    init => {
                                                        if root.log-follow {
                                                            self.content-y = -100000px;
                                                        }
                                                    }
                                                    property <int> generation: root.log-generation;
                                                    changed generation => {
                                                        if root.log-follow {
                                                            self.content-y = -100000px;
                                                        }
                                                    }
                                                    for line in root.logs: LogRow {
                                                        width: parent.width;
                                                        padding-left: 12px;
                                                        padding-right: 12px;
                                                        padding-top: 3px;
                                                        padding-bottom: 4px;
                                                        line: line;
                                                    }
                                                }
                                                if root.logs.length == 0: EmptyState {
                                                    y: (parent.height - self.height) / 2;
                                                    width: parent.width;
                                                    height: 170px;
                                                    glyph: "terminal";
                                                    title: root.log-count == 0 ? "暂无日志" : "没有匹配的日志";
                                                    detail: root.log-count == 0 ? "服务输出、系统事件和错误信息会集中显示在这里。" : "调整日志筛选条件后再试。";
                                                }
                                            }
                                            Rectangle {
                                                height: 28px;
                                                background: Theme.panel-raised;
                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    cross-axis-alignment: center;
                                                    Text {
                                                        text: root.log-follow ? "跟随最新输出" : "已暂停自动滚动";
                                                        color: Theme.text-muted;
                                                        font-size: Theme.font-xs;
                                                        horizontal-stretch: 1;
                                                        min-width: 0px;
                                                        overflow: elide;
                                                    }
                                                    Text { text: "磁盘日志保留"; color: Theme.text-muted; font-size: Theme.font-xs; }
                                                }
                                                Rectangle { y: 0px; width: parent.width; height: 1px; background: Theme.border-soft; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: root.status-height;
                background: Theme.surface;
                HorizontalLayout {
                    padding-left: root.compact ? 12px : 16px;
                    padding-right: root.compact ? 12px : 16px;
                    spacing: 10px;
                    cross-axis-alignment: center;
                    StatusDot { tone: root.daemon-connected ? Theme.success : Theme.danger; }
                    Text {
                        text: root.daemon-status;
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        overflow: elide;
                    }
                    if !root.compact: Text {
                        text: "上次扫描 · " + root.last-discovery;
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                        min-width: 0px;
                        max-width: 240px;
                        overflow: elide;
                    }
                    if !root.compact: Rectangle { width: 1px; height: 12px; background: Theme.border; }
                    if !root.compact: Text {
                        text: root.close-to-tray ? "关闭窗口不会停止服务" : "关闭窗口将退出 GUI";
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                    }
                    Text { text: "v" + root.app-version; color: Theme.text-muted; font-size: Theme.font-xs; }
                }
                Rectangle { y: 0px; width: parent.width; height: 1px; background: Theme.border; }
            }
        }

        if root.create-menu-open: Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: transparent;
            TouchArea {
                clicked => { root.create-menu-open = false; }
            }
            Rectangle {
                x: parent.width - self.width - (root.compact ? 14px : 16px);
                y: root.header-height - 2px;
                width: 208px;
                height: 88px;
                border-radius: Theme.radius-md;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-color: Theme.shadow;
                drop-shadow-blur: 20px;
                drop-shadow-offset-y: 8px;
                forward-focus: menu-focus;
                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;
                    Button {
                        height: 34px;
                        text: "Windows 脚本服务";
                        clicked => { root.create-draft("windows"); }
                    }
                    Button {
                        height: 34px;
                        text: "WSL 脚本服务";
                        clicked => { root.create-draft("wsl"); }
                    }
                }
                menu-focus := FocusScope {
                    width: 0px;
                    init => { self.focus(); }
                    key-pressed(event) => {
                        if event.text == Key.Escape {
                            root.create-menu-open = false;
                            return accept;
                        }
                        return reject;
                    }
                }
            }
        }

        if root.toast-visible: Toast {
            x: parent.width - self.width - 16px;
            y: parent.height - self.height - root.status-height - 16px;
            width: min(420px, parent.width - 32px);
            message: root.toast-text;
            tone: root.toast-kind == "error" ? Theme.danger : root.toast-kind == "success" ? Theme.success : Theme.accent;
            TouchArea { clicked => { root.toast-visible = false; root.dismiss-toast(); } }
        }
    }
}
