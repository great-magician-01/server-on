export global Theme {
    in-out property <bool> dark: true;

    out property <color> bg: dark ? #0F141A : #F4F6F9;
    out property <color> bg-deep: dark ? #0A0E14 : #E9EEF4;
    out property <color> surface: dark ? #141A21 : #FFFFFF;
    out property <color> panel: dark ? #181F27 : #FFFFFF;
    out property <color> panel-raised: dark ? #1D252E : #F8FAFC;
    out property <color> panel-hover: dark ? #222C37 : #EEF4FA;
    out property <color> sidebar: dark ? #10161D : #F0F3F7;
    out property <color> border: dark ? #2A3441 : #D5DEE8;
    out property <color> border-soft: dark ? #202A36 : #E4EAF1;
    out property <color> border-strong: dark ? #3C4A5C : #B8C6D6;
    out property <color> text: dark ? #EEF3F8 : #16202D;
    out property <color> text-secondary: dark ? #B4C2D2 : #47596E;
    out property <color> text-muted: dark ? #8B9CB1 : #5E6E82;
    out property <color> accent: dark ? #60CDFF : #005FB8;
    out property <color> accent-strong: dark ? #2FA9F4 : #084C8F;
    out property <color> accent-soft: dark ? #12324A : #E5F1FC;
    out property <color> success: dark ? #4ADE9C : #0C6C46;
    out property <color> warning: dark ? #F5C26B : #8A5104;
    out property <color> danger: dark ? #FF8797 : #B22F44;
    out property <color> info: dark ? #82C5FF : #1856A8;
    out property <color> violet: dark ? #C4B5FD : #6547AA;
    out property <color> teal: dark ? #5EEAD4 : #0A6F68;
    out property <color> pink: dark ? #F5A4C5 : #9A3664;
    out property <color> log-bg: dark ? #0B1119 : #F7F9FC;
    out property <color> log-text: dark ? #C6D3E1 : #36495D;
    out property <color> overlay-hover: dark ? #FFFFFF08 : #0B355408;
    out property <color> shadow: dark ? #00000055 : #15304D18;
    out property <string> ui-font: "Microsoft YaHei UI";
    out property <string> mono-font: "Cascadia Mono";
    out property <length> font-xs: 11px;
    out property <length> font-sm: 12px;
    out property <length> font-md: 13px;
    out property <length> font-lg: 15px;
    out property <length> font-xl: 20px;
    out property <length> font-2xl: 24px;
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 20px;
    out property <length> space-6: 24px;
    out property <length> control-sm: 28px;
    out property <length> control-md: 32px;
    out property <length> control-lg: 36px;
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 14px;
    out property <length> radius-pill: 999px;
}

export global Ui {
    public pure function state-label(state: string) -> string {
        if state == "running" { return "运行中"; }
        if state == "starting" { return "启动中"; }
        if state == "stopping" { return "停止中"; }
        if state == "stopped" { return "已停止"; }
        if state == "failed" { return "失败"; }
        if state == "degraded" { return "降级"; }
        if state == "unknown" { return "未知"; }
        if state == "missing" { return "已丢失"; }
        return "未知";
    }
    public pure function state-tone(state: string) -> color {
        if state == "running" { return Theme.success; }
        if state == "starting" { return Theme.info; }
        if state == "stopping" { return Theme.warning; }
        if state == "failed" { return Theme.danger; }
        if state == "degraded" { return Theme.warning; }
        if state == "unknown" { return Theme.violet; }
        if state == "missing" { return Theme.pink; }
        return Theme.text-muted;
    }
    public pure function health-label(health: string) -> string {
        if health == "healthy" { return "健康"; }
        if health == "unhealthy" { return "异常"; }
        if health == "checking" { return "检查中"; }
        if health == "unknown" { return "未知"; }
        return "未配置";
    }
    public pure function health-tone(health: string) -> color {
        if health == "healthy" { return Theme.success; }
        if health == "unhealthy" { return Theme.danger; }
        if health == "checking" { return Theme.info; }
        if health == "unknown" { return Theme.warning; }
        return Theme.text-muted;
    }
    public pure function kind-label(kind: string) -> string {
        if kind == "windows" { return "Windows"; }
        if kind == "wsl" { return "WSL"; }
        if kind == "container" { return "容器"; }
        return kind;
    }
    public pure function kind-glyph(kind: string) -> string {
        if kind == "windows" { return "windows"; }
        if kind == "wsl" { return "terminal"; }
        if kind == "container" { return "container"; }
        return "grid";
    }
    public pure function kind-tone(kind: string) -> color {
        if kind == "windows" { return Theme.info; }
        if kind == "wsl" { return Theme.violet; }
        if kind == "container" { return Theme.teal; }
        return Theme.text-muted;
    }
    public pure function engine-tone(engine: string) -> color {
        if engine == "available" { return Theme.success; }
        if engine == "stopped" { return Theme.danger; }
        if engine == "unknown" { return Theme.warning; }
        return Theme.text-muted;
    }
    public pure function log-label(level: string) -> string {
        if level == "stderr" || level == "error" { return "错误"; }
        if level == "warn" { return "警告"; }
        if level == "info" { return "信息"; }
        if level == "stdout" { return "输出"; }
        if level == "system" { return "系统"; }
        return level;
    }
    public pure function log-tone(level: string) -> color {
        if level == "stderr" || level == "error" { return Theme.danger; }
        if level == "warn" { return Theme.warning; }
        if level == "info" { return Theme.info; }
        if level == "system" { return Theme.violet; }
        return Theme.text-secondary;
    }
}
